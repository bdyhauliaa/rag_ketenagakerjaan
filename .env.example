# Salin file ini menjadi .env dan isi API key yang kamu pakai
# cp .env.example .env

# Pilih salah satu provider LLM (isi yang akan dipakai):
LLM_PROVIDER=gemini   # gemini | groq | openai

# Google Gemini — gratis, daftar di https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — gratis, daftar di https://console.groq.com (fallback)
# GROQ_API_KEY=your_groq_api_key_here

# OpenAI — berbayar, daftar di https://platform.openai.com
# OPENAI_API_KEY=your_openai_api_key_here
